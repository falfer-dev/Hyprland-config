{
    // --- CONFIGURACIÓN GENERAL DE LA BARRA ---
    "layer": "top",
    "position": "top",
    "height": 25,
    "spacing": 1,
    "margin-top": 1,
    "margin-left": 2,
    "margin-right": 2,
    "margin-bottom": 0,

    // --- DISTRIBUCIÓN DE MÓDULOS ---
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "backlight",
        "wireplumber",
        "battery",
        "temperature",
        "clock"
    ],

    // =============================================================================
    // CONFIGURACIÓN DETALLADA DE CADA MÓDULO

    // Espacios de Trabajo
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "default": ""
        }
    },

    // Ventana activa
    "hyprland/window": {
        "format": " {title} ",
        "max-length": 50,
        "separate-outputs": true
    },

    // Inhibidor de suspensión
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    // Brillo
    "backlight": {
        "interval": 2,
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set +4%",
        "on-scroll-down": "brightnessctl set -4%"
    },

    // Audio
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "pavucontrol"
    },

    // Batería
    "battery": {
        "interval": 10,
        "format": "{icon} {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    // Temperatura
    "temperature": {
        "thermal-zone": 2,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },

    // Reloj
    "clock": {
        "format": " {:%H:%M:%S}",
        "format-alt": " {:%d-%m-%Y}",
        "interval": 1
    }
}
